{
  "format": "digital-card",
  "contractVersion": "0.1.0",
  "id": "example.lakeside",
  "revision": 1,
  "title": "Lakeside Study",
  "summary": "A structural example of a layered scene with local reflective effects and a video back. Media and hashes are placeholders.",
  "profile": "portable",
  "canvas": {
    "width": 1000,
    "height": 1500
  },
  "faces": {
    "front": {
      "scene": "scenes/front.json",
      "poster": "poster-front",
      "description": "A quiet lake below a softly blooming firework, with a petal and a small companion in the foreground."
    },
    "back": {
      "scene": "scenes/back.json",
      "poster": "poster-back",
      "description": "A muted cinematic lake reflection with a static fallback."
    }
  },
  "assets": [
