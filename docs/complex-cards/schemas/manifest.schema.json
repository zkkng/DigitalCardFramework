{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-card.invalid/schema/manifest-0.1.0.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "digital-card"
    },
    "contractVersion": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z][\\w.-]{0,99}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "profile": {
      "const": "portable"
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        }
      },
      "required": [
        "width",
        "height"
      ]
    },
    "faces": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "front": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scene": {
              "type": "string"
            },
            "poster": {
              "type": "string",
              "pattern": "^[a-zA-Z][\\w.-]{0,99}$"
            },
            "description": {
              "type": "string"
            }
          },
          "required": [
            "scene",
            "poster",
            "description"
          ]
        },
        "back": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scene": {
              "type": "string"
            },
            "poster": {
              "type": "string",
              "pattern": "^[a-zA-Z][\\w.-]{0,99}$"
            },
            "description": {
              "type": "string"
            }
          },
          "required": [
            "scene",
            "poster",
            "description"
          ]
        }
      },
      "required": [
        "front",
        "back"
      ]
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][\\w.-]{0,99}$"
          },
          "path": {
            "type": "string"
          },
          "mediaType": {
            "enum": [
              "image/png",
              "image/webp",
              "image/jpeg",
              "video/mp4",
              "video/webm",
              "audio/wav",
              "audio/mpeg",
              "model/gltf-binary",
              "application/x-rive",
              "application/zip"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 262144000
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16384
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16384
          },
          "duration": {
            "type": "number",
            "minimum": 0,
            "maximum": 3600
          },
          "role": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "path",
          "mediaType",
          "sha256",
          "bytes",
          "role"
        ]
      },
      "minItems": 2,
      "maxItems": 2000
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0,
          "maxItems": 2000
        },
        "optional": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "fallback": {
                "enum": [
                  "poster",
                  "omit-decorative",
                  "static-pose"
                ]
              }
            },
            "required": [
              "id",
              "fallback"
            ]
          },
          "minItems": 0,
          "maxItems": 2000
        }
      },
      "required": [
        "required",
        "optional"
      ]
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "poster": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxEdge": {
              "type": "number",
              "minimum": 64,
              "maximum": 4096
            }
          },
          "required": [
            "maxEdge"
          ]
        },
        "lite": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxEdge": {
              "type": "number",
              "minimum": 64,
              "maximum": 4096
            }
          },
          "required": [
            "maxEdge"
          ]
        },
        "standard": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxEdge": {
              "type": "number",
              "minimum": 64,
              "maximum": 4096
            }
          },
          "required": [
            "maxEdge"
          ]
        },
        "ultra": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxEdge": {
              "type": "number",
              "minimum": 64,
              "maximum": 4096
            }
          },
          "required": [
            "maxEdge"
          ]
        }
      },
      "required": [
        "poster",
        "lite"
      ]
    },
    "credits": {},
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": [
              "number",
              "boolean"
            ]
          },
          "default": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          }
        },
        "required": [
          "type",
          "default"
        ]
      }
    },
    "extensions": {}
  },
  "required": [
    "format",
    "contractVersion",
    "id",
    "revision",
    "title",
    "summary",
    "profile",
    "canvas",
    "faces",
    "assets",
    "capabilities",
    "quality"
  ]
}
