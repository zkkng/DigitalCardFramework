{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-card.invalid/schema/manifest-0.1.0.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "digital-card"
    },
    "contractVersion": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z][\\w.-]{0,99}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "profile": {
      "const": "portable"
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        }
      },
      "required": [
        "width",
        "height"
      ]
    },
    "faces": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "front": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scene": {
              "type": "string"
            },
            "poster": {
              "type": "string",
              "pattern": "^[a-zA-Z][\\w.-]{0,99}$"
            },
            "description": {
              "type": "string"
            }
          },
          "required": [
            "scene",
            "poster",
            "description"
          ]
        },
        "back": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scene": {
              "type": "string"
            },
            "poster": {
              "type": "string",
              "pattern": "^[a-zA-Z][\\w.-]{0,99}$"
            },
            "description": {
              "type": "string"
            }
          },
          "required": [
            "scene",
            "poster",
            "description"
          ]
        }
      },
      "required": [
        "front",
        "back"
      ]
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][\\w.-]{0,99}$"
          },
          "path": {
            "type": "string"
          },
          "mediaType": {
            "enum": [
              "image/png",
              "image/webp",
              "image/jpeg",
              "video/mp4",
              "video/webm",
              "audio/wav",
              "audio/mpeg",
              "model/gltf-binary",
              "application/x-rive",
              "application/zip",
              "font/woff2",
              "font/woff",
              "font/ttf",
              "font/otf"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 262144000
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16384
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16384
          },
          "duration": {
            "type": "number",
            "minimum": 0,
            "maximum": 3600
          },
          "role": {
            "type": "string"
          },
          "font": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "family": {
                "type": "string"
              },
              "face": {
                "type": "string"
              },
              "license": {
                "type": "string"
              },
              "axes": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "min": {
                      "type": "number"
                    },
                    "max": {
                      "type": "number"
                    },
                    "default": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "name",
                    "min",
                    "max",
                    "default"
                  ]
                }
              }
            },
            "required": [
              "family",
              "face",
              "license"
            ]
          }
        },
        "required": [
          "id",
          "path",
          "mediaType",
          "sha256",
          "bytes",
          "role"
        ]
      },
      "minItems": 2,
      "maxItems": 2000
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0,
          "maxItems": 2000
        },
        "optional": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "fallback": {
                "enum": [
                  "poster",
                  "omit-decorative",
                  "static-pose"
                ]
              }
            },
            "required": [
              "id",
              "fallback"
            ]
          },
          "minItems": 0,
          "maxItems": 2000
        }
      },
      "required": [
        "required",
        "optional"
      ]
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "poster": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxEdge": {
              "type": "number",
              "minimum": 64,
              "maximum": 4096
            }
          },
          "required": [
            "maxEdge"
          ]
        },
        "lite": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxEdge": {
              "type": "number",
              "minimum": 64,
              "maximum": 4096
            }
          },
          "required": [
            "maxEdge"
          ]
        },
        "standard": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxEdge": {
              "type": "number",
              "minimum": 64,
              "maximum": 4096
            }
          },
          "required": [
            "maxEdge"
          ]
        },
        "ultra": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxEdge": {
              "type": "number",
              "minimum": 64,
              "maximum": 4096
            }
          },
          "required": [
            "maxEdge"
          ]
        }
      },
      "required": [
        "poster",
        "lite"
      ]
    },
    "credits": {},
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": [
              "number",
              "boolean"
            ]
          },
          "default": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          }
        },
        "required": [
          "type",
          "default"
        ]
      }
    },
    "extensions": {},
    "authoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "context": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cardId": {
              "type": "string",
              "pattern": "^[a-zA-Z][\\w.-]{0,99}$"
            },
            "lineId": {
              "type": "string",
              "pattern": "^[a-zA-Z][\\w.-]{0,99}$"
            },
            "type": {
              "type": "string",
              "pattern": "^[a-zA-Z][\\w.-]{0,99}$"
            },
            "variantId": {
              "type": "string",
              "pattern": "^[a-zA-Z][\\w.-]{0,99}$"
            }
          },
          "required": []
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9._-]{0,99}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "description": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "integer",
                  "number",
                  "string",
                  "boolean",
                  "array",
                  "object"
                ]
              },
              "scope": {
                "enum": [
                  "card",
                  "variant",
                  "copy"
                ]
              },
              "visibility": {
                "enum": [
                  "public",
                  "owner",
                  "operator"
                ]
              },
              "source": {
                "enum": [
                  "author",
                  "admin",
                  "provider",
                  "calculated"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "nullable": {
                "type": "boolean"
              },
              "default": {},
              "fixed": {},
              "minimum": {
                "type": "number"
              },
              "maximum": {
                "type": "number"
              },
              "minLength": {
                "type": "integer"
              },
              "maxLength": {
                "type": "integer"
              },
              "minItems": {
                "type": "integer"
              },
              "maxItems": {
                "type": "integer"
              },
              "enum": {
                "type": "array",
                "items": {},
                "maxItems": 128
              },
              "precision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 8
              },
              "unit": {
                "type": "string"
              },
              "group": {
                "type": "string"
              },
              "order": {
                "type": "integer"
              },
              "requiredWhen": {
                "description": "Bounded expression: field, exists, not, eq, comparisons, and/or, arithmetic."
              },
              "calculate": {
                "description": "Bounded numeric expression; source must be calculated."
              },
              "items": {
                "type": "object",
                "description": "Nested field constraints; key and label are optional."
              },
              "properties": {
                "type": "object",
                "additionalProperties": {
                  "type": "object"
                }
              },
              "additionalProperties": {
                "type": "boolean"
              }
            },
            "required": [
              "key",
              "label",
              "type"
            ]
          },
          "minItems": 0,
          "maxItems": 128
        },
        "values": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "card": {
              "type": "object"
            },
            "variant": {
              "type": "object"
            }
          },
          "required": []
        },
        "template": {
          "type": "string"
        },
        "masks": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "policyRevision": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": []
    }
  },
  "required": [
    "format",
    "contractVersion",
    "id",
    "revision",
    "title",
    "summary",
    "profile",
    "canvas",
    "faces",
    "assets",
    "capabilities",
    "quality"
  ]
}
