{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-card.invalid/schema/scene2d-0.1.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "dialect": {
      "const": "dc.scene2d@0.1"
    },
    "background": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      },
      "minItems": 0,
      "maxItems": 512
    }
  },
  "required": [
    "dialect",
    "nodes"
  ],
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][\\w.-]{0,99}$"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "enum": [
            "image",
            "video",
            "audio",
            "group",
            "text",
            "adapter"
          ]
        },
        "sampling": {
          "enum": [
            "linear",
            "nearest"
          ]
        },
        "asset": {
          "type": "string",
          "pattern": "^[a-zA-Z][\\w.-]{0,99}$"
        },
        "rect": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "rotation": {
          "type": "number"
        },
        "scaleX": {
          "type": "number"
        },
        "scaleY": {
          "type": "number"
        },
        "pivotX": {
          "type": "number"
        },
        "pivotY": {
          "type": "number"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "parallax": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "brightness": {
          "type": "number"
        },
        "saturation": {
          "type": "number"
        },
        "blend": {
          "enum": [
            "normal",
            "screen",
            "add",
            "multiply"
          ]
        },
        "mask": {
          "$ref": "#/$defs/mask"
        },
        "material": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "bloom",
                "water",
                "glitter",
                "spot",
                "foil"
              ]
            },
            "progress": {
              "type": "number"
            },
            "angle": {
              "type": "number"
            },
            "intensity": {
              "type": "number"
            },
            "radius": {
              "type": "number"
            },
            "feather": {
              "type": "number"
            },
            "center": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "sweep": {
              "type": "number"
            },
            "size": {
              "type": "number"
            },
            "density": {
              "type": "number"
            },
            "seed": {
              "type": "number"
            },
            "shape": {
              "enum": [
                "circle",
                "hexagon",
                "shard",
                "star"
              ]
            },
            "color": {
              "type": "string"
            },
            "flakeAsset": {
              "type": "string",
              "pattern": "^[a-zA-Z][\\w.-]{0,99}$"
            },
            "flakeColor": {
              "enum": [
                "holo",
                "texture"
              ]
            },
            "maskAsset": {
              "type": "string",
              "pattern": "^[a-zA-Z][\\w.-]{0,99}$"
            },
            "mask": {
              "$ref": "#/$defs/mask"
            },
            "mode": {
              "enum": [
                "surface",
                "overlay"
              ]
            },
            "roughness": {
              "type": "number"
            },
            "variation": {
              "type": "number"
            }
          },
          "required": [
            "kind"
          ],
          "not": {
            "properties": {
              "mask": {},
              "maskAsset": {}
            },
            "required": [
              "mask",
              "maskAsset"
            ]
          }
        },
        "bindings": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "array",
                "minItems": 2,
                "maxItems": 9,
                "items": {}
              }
            ]
          }
        },
        "animation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "progress": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 9,
                  "items": {}
                }
              ]
            },
            "loop": {
              "type": "boolean"
            },
            "frames": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "asset": {
                    "type": "string",
                    "pattern": "^[a-zA-Z][\\w.-]{0,99}$"
                  },
                  "rect": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 4,
                    "maxItems": 4
                  },
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "width": {
                    "type": "number"
                  },
                  "height": {
                    "type": "number"
                  },
                  "duration": {
                    "type": "number"
                  },
                  "name": {
                    "type": "string"
                  }
                },
                "required": [
                  "asset",
                  "rect",
                  "x",
                  "y",
                  "width",
                  "height",
                  "duration"
                ]
              },
              "minItems": 2,
              "maxItems": 100
            }
          },
          "required": [
            "progress",
            "frames"
          ]
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          },
          "minItems": 0,
          "maxItems": 512
        },
        "isolate": {
          "const": true
        },
        "text": {
          "type": "string",
          "maxLength": 10000
        },
        "typography": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fontAsset": {
              "type": "string"
            },
            "size": {
              "type": "number"
            },
            "minSize": {
              "type": "number"
            },
            "weight": {
              "type": "number"
            },
            "style": {
              "enum": [
                "normal",
                "italic",
                "oblique"
              ]
            },
            "lineHeight": {
              "type": "number"
            },
            "letterSpacing": {
              "type": "number"
            },
            "paragraphSpacing": {
              "type": "number"
            },
            "align": {
              "enum": [
                "left",
                "center",
                "right",
                "start",
                "end"
              ]
            },
            "verticalAlign": {
              "enum": [
                "top",
                "middle",
                "bottom"
              ]
            },
            "overflow": {
              "enum": [
                "wrap",
                "shrink",
                "ellipsis",
                "clip",
                "grow"
              ]
            },
            "direction": {
              "enum": [
                "auto",
                "ltr",
                "rtl"
              ]
            },
            "language": {
              "type": "string"
            },
            "color": {
              "type": "string"
            },
            "outlineColor": {
              "type": "string"
            },
            "outlineWidth": {
              "type": "number"
            },
            "shadowColor": {
              "type": "string"
            },
            "shadowBlur": {
              "type": "number"
            },
            "shadowX": {
              "type": "number"
            },
            "shadowY": {
              "type": "number"
            },
            "axes": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              }
            }
          },
          "required": []
        },
        "runs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string"
              },
              "color": {
                "type": "string"
              },
              "weight": {
                "type": "number"
              },
              "style": {
                "enum": [
                  "normal",
                  "italic",
                  "oblique"
                ]
              },
              "icon": {
                "type": "string",
                "pattern": "^[a-zA-Z][\\w.-]{0,99}$"
              }
            },
            "required": [
              "text"
            ]
          },
          "minItems": 0,
          "maxItems": 128
        },
        "stat": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[a-zA-Z][\\w.-]{0,99}$"
            },
            "scope": {
              "enum": [
                "card",
                "variant"
              ]
            },
            "label": {
              "type": "string"
            },
            "unit": {
              "type": "string"
            },
            "precision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8
            },
            "missing": {
              "type": "string"
            },
            "view": {
              "enum": [
                "text",
                "badge",
                "bar"
              ]
            },
            "minimum": {
              "type": "number"
            },
            "maximum": {
              "type": "number"
            },
            "locale": {
              "type": "string"
            }
          },
          "required": [
            "key"
          ]
        },
        "locked": {
          "type": "boolean"
        },
        "readingOrder": {
          "type": "integer",
          "minimum": -10000,
          "maximum": 10000
        },
        "font": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "video": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "autoplay-muted",
                "on-activate"
              ]
            },
            "loop": {
              "type": "boolean"
            },
            "muted": {
              "const": true
            },
            "poster": {
              "type": "string",
              "pattern": "^[a-zA-Z][\\w.-]{0,99}$"
            }
          },
          "required": [
            "mode",
            "muted",
            "poster"
          ]
        },
        "audio": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "loop": {
              "type": "boolean"
            },
            "volume": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "loop",
            "volume"
          ]
        },
        "adapter": {
          "type": "string"
        },
        "data": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "isolate": {
                "const": true
              }
            },
            "required": [
              "isolate"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "group"
              },
              "width": {
                "type": "number",
                "minimum": 0.001,
                "maximum": 20000
              },
              "height": {
                "type": "number",
                "minimum": 0.001,
                "maximum": 20000
              }
            },
            "required": [
              "type",
              "width",
              "height"
            ]
          }
        }
      ]
    },
    "mask": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asset": {
          "type": "string",
          "pattern": "^[a-zA-Z][\\w.-]{0,99}$"
        },
        "polygon": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "minItems": 3,
          "maxItems": 64
        },
        "invert": {
          "type": "boolean"
        },
        "rect": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "transform": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "number",
              "minimum": -100,
              "maximum": 100
            },
            "y": {
              "type": "number",
              "minimum": -100,
              "maximum": 100
            },
            "scaleX": {
              "type": "number",
              "anyOf": [
                {
                  "minimum": -100,
                  "maximum": -0.001
                },
                {
                  "minimum": 0.001,
                  "maximum": 100
                }
              ]
            },
            "scaleY": {
              "type": "number",
              "anyOf": [
                {
                  "minimum": -100,
                  "maximum": -0.001
                },
                {
                  "minimum": 0.001,
                  "maximum": 100
                }
              ]
            },
            "rotation": {
              "type": "number",
              "minimum": -360000,
              "maximum": 360000
            },
            "pivotX": {
              "type": "number",
              "minimum": -100,
              "maximum": 100
            },
            "pivotY": {
              "type": "number",
              "minimum": -100,
              "maximum": 100
            }
          },
          "required": []
        }
      },
      "required": [],
      "oneOf": [
        {
          "properties": {
            "asset": {}
          },
          "required": [
            "asset"
          ],
          "not": {
            "properties": {
              "polygon": {}
            },
            "required": [
              "polygon"
            ]
          }
        },
        {
          "properties": {
            "polygon": {}
          },
          "required": [
            "polygon"
          ],
          "not": {
            "anyOf": [
              {
                "properties": {
                  "asset": {}
                },
                "required": [
                  "asset"
                ]
              },
              {
                "properties": {
                  "rect": {}
                },
                "required": [
                  "rect"
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
