SITE_ORIGIN=https://cards.example.com
SITE_HOST=cards.example.com
SITE_NAME=Card Atelier
OIDC_ISSUER=https://identity.example.com
OIDC_CLIENT_ID=configure-your-registered-client
# Register SITE_ORIGIN/auth/callback at the issuer. Never use display names for authority.
OPERATOR_SUBJECTS=[]
ASSET_ORIGINS=https://your-content.example.com
# Docker Compose reads the two ignored ./secrets files. Native Node can use *_FILE too.
DATABASE_PATH=data/production.sqlite
CATALOG_FILE=content/catalog.json
STATE_ENCRYPTION_KEY_FILE=secrets/state-key.txt
OIDC_CLIENT_SECRET_FILE=secrets/oidc-client-secret.txt
