{
  "name": "@digital-card/framework",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Headless digital card collection core and replaceable web presentation",
  "engines": {
    "node": ">=24.14.0"
  },
  "exports": {
    ".": "./src/index.js",
    "./sqlite": "./src/sqlite.js",
    "./ui": "./src/ui.js",
    "./client": "./src/client.js",
    "./admin-client": "./src/admin-client.js",
    "./admin-ui": "./src/admin-ui.js",
    "./http": "./src/http.js",
    "./importer": "./src/importer.js",
    "./trade-client": "./src/trade-client.js",
    "./trading-ui": "./src/trading-ui.js",
    "./collection-ui": "./src/collection-ui.js",
    "./inspector-ui": "./src/inspector-ui.js",
    "./studio-ui": "./src/studio-ui.js",
    "./player-ui": "./src/player-ui.js",
    "./auth": "./src/auth.js",
    "./encryption": "./src/encryption.js",
    "./contracts": "./src/contracts.js",
    "./presentation": "./src/presentation/index.js",
    "./presentation/studio": "./src/presentation/studio.js",
    "./presentation/service": "./src/presentation/service.js",
    "./presentation/authoring": "./src/presentation/authoring.js",
    "./presentation/compiler": "./src/presentation/compiler.js",
    "./presentation/layered-source": "./src/presentation/layered-source.js",
    "./presentation/layered-package": "./src/presentation/layered-package.js",
    "./access": "./src/access.js",
    "./presentation/adapters": "./src/presentation/adapters.js",
    "./presentation/extensions": "./src/presentation/extensions.js",
    "./presentation/signatures": "./src/presentation/signatures.js",
    "./presentation/integration": "./src/presentation/integration.js",
    "./presentation/program": "./src/presentation/program.js",
    "./presentation/identity": "./src/presentation/identity.js",
    "./presentation/package": "./src/presentation/package.js",
    "./presentation/schema": "./src/presentation/schema.js",
    "./presentation/project": "./src/presentation/project.js",
    "./presentation/motion": "./src/presentation/motion.js",
    "./presentation/layered-import": "./src/presentation/layered-import.js",
    "./presentation/performance": "./src/presentation/performance.js",
    "./presentation/album-motion": "./src/presentation/album-motion.js",
    "./presentation/gif-source": "./src/presentation/gif-source.js",
    "./currency-gateway": "./src/currency-gateway.js",
    "./presentation/png-encode": "./src/presentation/png-encode.js",
    "./presentation/node-http": "./src/presentation/node-http.js",
    "./card-types": "./src/card-types.js",
    "./code-ui": "./src/code-ui.js",
    "./code-vault": "./src/code-vault.js",
    "./code-gateway": "./src/code-gateway.js",
    "./marketplace-ui": "./src/marketplace-ui.js",
    "./remote-actions": {
      "types": "./src/remote-actions.d.ts",
      "default": "./src/remote-actions.js"
    },
    "./card-policy": "./src/card-policy.js",
    "./card-policy-schema": "./src/card-policy-schema.js",
    "./card-policy-ui": "./src/card-policy-ui.js",
    "./presentation/authoring-tools": "./src/presentation/authoring-tools.js",
    "./presentation/text": "./src/presentation/text.js",
    "./presentation/stats-csv": "./src/presentation/stats-csv.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "node examples/server.js",
    "production": "node --env-file=.env host/server.js",
    "contract": "node tools/generate-openapi.js",
    "test:browser": "node test/presentation-audit-browser.mjs",
    "test:spec": "node docs/complex-cards/check-examples.mjs",
    "test:coverage": "node --experimental-test-coverage --test test/*.test.js",
    "build:authoring": "node tools/build-fonts.mjs",
    "test:authoring": "node test/card-authoring-browser.mjs",
    "test:admin": "node --test test/admin.test.js test/admin-http.test.js test/admin-ui.test.js",
    "test:admin:browser": "node test/admin-browser.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "fontkit": "2.0.4",
    "openid-client": "6.8.8",
    "yaml": "2.9.1"
  },
  "packageManager": "pnpm@11.19.0",
  "devDependencies": {
    "happy-dom": "20.14.5",
    "playwright": "1.62.1"
  }
}
